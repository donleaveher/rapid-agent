# ---- Gemini (default backend; submission runs on Vertex) -------------------
# Dev: free AI Studio key.
GOOGLE_API_KEY=your-google-ai-studio-key
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GEMINI_MODEL=gemini-3.5-flash          # override per run; lite variants have higher free quota
# Submission: switch to Vertex (comment the two lines above, uncomment below,
# then run: gcloud auth application-default login)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# ---- Arize Phoenix (tracing + MCP) -----------------------------------------
# Endpoint MUST include the /s/<space-id> path; headers MUST be api_key=...
PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/s/<your-space-id>
PHOENIX_CLIENT_HEADERS=api_key=your-phoenix-key

# ---- Optional: DeepSeek backend (DEV VALIDATION ONLY, not for submission) ---
# Lets the loop run without the proxy when Gemini is unreachable.
# LLM_BACKEND=deepseek
# DEEPSEEK_API_KEY=your-deepseek-key
# DEEPSEEK_MODEL=deepseek-v4-flash       # or deepseek-v4-pro

# ---- Optional knobs (sensible defaults; usually leave unset) ----------------
# SQLOOP_MAX_LLM_CALLS=12                # per-turn LLM-call ceiling (loop guard)
# SQLOOP_EVAL_CONCURRENCY=10             # parallel evals (set >1 only for DeepSeek)
# SQLOOP_EVAL_GAP=0                      # seconds between calls (3 for Gemini free tier)
# SQLOOP_SCHEMA_LINK=auto               # auto|off  schema-linking
# SQLOOP_MEMORY_RERANK=auto             # auto|on|off  hybrid memory retrieval
